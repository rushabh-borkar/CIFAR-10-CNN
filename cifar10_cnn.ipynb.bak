  {
   "cell_type": "markdown",
   "id": "fdb834d6",
   "metadata": {},
   "source": [
    "##Building CNN arch\n",
    "\n",
    "Ouput size =[ N + 2P - K / s ] + 1\n",
    "#N = input height or width\n",
    "#P = padding (default 0)\n",
    "#K = kernel size\n",
    "#S = stride"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 66,
   "id": "b489c36d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from torch import nn as nn\n",
    "\n",
    "Conventional_layer = nn.Conv2d(\n",
    "    in_channels=3,\n",
    "    out_channels=16,\n",
    "    kernel_size=3,\n",
    "    stride=1,\n",
    ")\n",
    "\n",
    "Sequential_layer = nn.Sequential(\n",
    "    Conventional_layer,\n",
    "    nn.ReLU(),\n",
    "    nn.MaxPool2d(\n",
    "        kernel_size=2,\n",
    "        stride=1\n",
    "    ),\n",
    "    nn.Flatten(),\n",
    "    nn.Linear(16 * 29 * 29, 128),\n",
    "    nn.Linear(128,10)\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 67,
   "id": "53b71f48",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Input shape: torch.Size([1, 3, 32, 32])\n",
      "Output shape: torch.Size([1, 10])\n",
      "tensor([[-0.1810,  0.1073,  0.0595, -0.0363,  0.1798, -0.0681, -0.2004, -0.1620,\n",
      "         -0.1123, -0.0411]], grad_fn=<AddmmBackward0>)\n"
     ]
    }
   ],
   "source": [
    "dummy_input = torch.randn(1, 3, 32, 32)\n",
    "\n",
    "output = Sequential_layer(dummy_input)\n",
    "\n",
    "print(\"Input shape:\", dummy_input.shape)\n",
    "print(\"Output shape:\", output.shape)\n",
    "print(output)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5ce16d5e",
   "metadata": {},
   "source": [
    "Defining Loss Function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 68,
   "id": "4b4c5c06",
   "metadata": {},
   "outputs": [],
   "source": [
    "loss_fn = nn.CrossEntropyLoss()\n",
    "\n",
    "optimizer = torch.optim.Adam(Sequential_layer.parameters(),\n",
    "                             lr = 0.01)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7c58cb14",
   "metadata": {},
   "source": [
    "optimizer.zero_grad() → Clears previous gradients.\n",
    "\n",
    "loss_value.backward() → Calculates fresh gradients for the current batch.\n",
    "\n",
    "optimizer.step() → Updates model weights using those gradients."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 78,
   "id": "37d4ca7c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Epoch: 1 | Average Training Loss: 0.5456 | Validation Accuracy: 0.5576\n",
      "Epoch: 2 | Average Training Loss: 0.5242 | Validation Accuracy: 0.5667\n",
      "Epoch: 3 | Average Training Loss: 0.5040 | Validation Accuracy: 0.5640\n",
      "Epoch: 4 | Average Training Loss: 0.4899 | Validation Accuracy: 0.5546\n",
      "Epoch: 5 | Average Training Loss: 0.4681 | Validation Accuracy: 0.5600\n",
      "Epoch: 6 | Average Training Loss: 0.4591 | Validation Accuracy: 0.5514\n",
      "Epoch: 7 | Average Training Loss: 0.4324 | Validation Accuracy: 0.5494\n",
      "Epoch: 8 | Average Training Loss: 0.4349 | Validation Accuracy: 0.5608\n",
      "Epoch: 9 | Average Training Loss: 0.4065 | Validation Accuracy: 0.5455\n",
      "Epoch: 10 | Average Training Loss: 0.4043 | Validation Accuracy: 0.5525\n"
     ]
    }
   ],
   "source": [
    "epochs = 10\n",
    "\n",
    "for epoch in range(epochs):\n",
    "    # Training\n",
    "    Sequential_layer.train()\n",
    "\n",
    "    total_loss = 0.0\n",
    "    total_images = 0\n",
    "\n",
    "    for batch_idx, (images, labels) in enumerate(train_loader):\n",
    "        optimizer.zero_grad()\n",
    "\n",
    "        outputs = Sequential_layer(images)\n",
    "        loss_value = loss_fn(outputs, labels)\n",
    "\n",
    "        loss_value.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        total_loss += loss_value.item() * images.size(0)\n",
    "        total_images += images.size(0)\n",
    "\n",
    "    avg_train_loss = total_loss / total_images\n",
    "\n",
    "    # Validation\n",
    "    Sequential_layer.eval()\n",
    "\n",
    "    correct = 0\n",
    "    total = 0\n",
    "\n",
    "    with torch.inference_mode():\n",
    "        for images, labels in test_loader:\n",
    "            outputs = Sequential_layer(images)\n",
    "            predictions = torch.argmax(outputs, dim=1)\n",
    "\n",
    "            correct += (predictions == labels).sum().item()\n",
    "            total += labels.size(0)\n",
    "\n",
    "    val_accuracy = correct / total\n",
    "\n",
    "    print(\n",
    "        f\"Epoch: {epoch + 1} | \"\n",
    "        f\"Average Training Loss: {avg_train_loss:.4f} | \"\n",
    "        f\"Validation Accuracy: {val_accuracy:.4f}\"\n",
    "    )"
   ]
  },
