   "cell_type": "markdown",
   "id": "1255cf23",
   "metadata": {},
   "source": [
    "##CONVERTING TO TENSOR"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "de68b927",
   "metadata": {},
   "outputs": [],
   "source": [
    "from PIL import Image\n",
